{
  "name": "gin-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Gin — self-hosted autonomous AI agent platform: durable, observable, governed, cost-controlled.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "oxlint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
