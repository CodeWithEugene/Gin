{
  "name": "@gin/email",
  "version": "0.1.0",
  "description": "Gin email: IMAP read + SMTP send as agent tools, behind injectable ports.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gin/core": "workspace:*",
    "@gin/tools": "workspace:*",
    "imapflow": "^1.0.190",
    "mailparser": "^3.7.0",
    "nodemailer": "^8.0.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
